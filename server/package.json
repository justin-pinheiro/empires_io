{
  "name": "empires_io",
  "version": "1.0.0",
  "type": "module",
  "description": "A minimalist, multiplayer strategy game where empires breathe, consume, and collapse.",
  "main": "server.js",
  "scripts": {
    "build": "tsc -p .",
    "start": "npm run build && node dist/server.js",
    "dev": "nodemon --watch src --ext ts --exec \"npm run build && node dist/server.js\"",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "keywords": [],
